{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PayrollSystem",
    "Audience": "PayrollUsers",
    "ExpiryMinutes": 20
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7060"
    ]
  },
  "Okta": {
    "Issuer": "{yourOktaDomain}/oauth2/default"
  }
}
