@model LeaveViewModel

@{
    ViewData["Title"] = "UpdateLeave";
}

<h1>Update Leave</h1>
@if (Model != null)
{
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="UpdateLeave">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>            
            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div><br />
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div><br />
            <div class="form-group">
                <label asp-for="Reason" class="control-label"></label>
                <input asp-for="Reason" class="form-control" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div><br />
           <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control"  readonly />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div><br />
             <div class="form-group">
                <label asp-for="EmployeeName" class="control-label"></label>
                <input asp-for="EmployeeName" class="form-control" readonly />
                <span asp-validation-for="EmployeeName" class="text-danger"></span>
            </div><br />
            <div class="form-group">
                <label asp-for="ActionByName" class="control-label"></label>
                <input asp-for="ActionByName" class="form-control" readonly />
                <span asp-validation-for="ActionByName" class="text-danger"></span>
            </div><br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
}

<div>
    <a asp-action="MyLeaves">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
