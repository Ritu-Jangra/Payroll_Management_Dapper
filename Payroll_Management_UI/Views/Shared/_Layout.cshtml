@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var token = HttpContextAccessor.HttpContext?.Session.GetString("AccessToken");
    bool isLoggedIn = !string.IsNullOrEmpty(token);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Payroll Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Login">
                    Payroll Management
                </a>

                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employee" asp-action="MyProfile">
                                    My Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leaves" asp-action="MyLeaves">
                                    My Leaves
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leaves" asp-action="LeaveRequests">
                                    Leave Requests
                                </a>
                            </li>
                        }

                    </ul>

                    @if (isLoggedIn)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <form asp-controller="Home"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="nav-link btn btn-link p-0">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- SIGNALR TOAST AREA -->
        <div id="notificationAlerts"
             class="position-fixed top-0 end-0 p-3"
             style="z-index: 9999;"></div>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Payroll Management
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.17/signalr.min.js"></script>

    <script>
        function showToast(message) {
            const container = document.getElementById("notificationAlerts");
            if (!container) return;

            const div = document.createElement("div");
            div.className = "alert alert-success alert-dismissible fade show shadow";
            div.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            container.appendChild(div);

            setTimeout(() => {
                div.classList.remove("show");
                div.remove();
            }, 5000);
        }

        (function () {

            const token = '@(HttpContextAccessor.HttpContext?.Session.GetString("AccessToken") ?? "")';

            if (!token || token.trim() === "") {
                console.log("No token → SignalR not started");
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/leaveHub", {
                    accessTokenFactory: () => token
                })
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveLeaveNotification", (leave) => {
                console.log("Notification received:", leave);
                showToast(`New leave request received`);
            });

            connection.start()
                .then(() => console.log("SignalR CONNECTED"))
                .catch(err => console.error("SignalR FAILED:", err));

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>